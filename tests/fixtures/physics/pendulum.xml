<!-- Synthetic 2 kg pendulum. Values are analytic test inputs, not Minerva data. -->
<mujoco model="synthetic_pendulum">
  <compiler angle="radian" inertiafromgeom="false" balanceinertia="false"/>
  <option timestep="0.0005" gravity="0 0 -9.81" integrator="implicitfast"/>
  <worldbody>
    <body name="arm">
      <joint name="hinge" type="hinge" axis="0 1 0" limited="false"/>
      <inertial pos="0.5 0 0" mass="2" diaginertia="0.01 0.16666666666666667 0.17"/>
      <geom type="capsule" fromto="0 0 0 1 0 0" size="0.03" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
</mujoco>
