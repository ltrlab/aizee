# Rust
/target/
/rust/target/
/rust/**/target/
**/*.rs.bk
# Applications share the root lockfile; obsolete per-crate lockfiles are ignored.
**/Cargo.lock
!/Cargo.lock

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
simulation_runs/
phase0_runs/
calibration_runs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
venv/
/.venv-platform/
/.venv-dev/
.hypothesis/
env/
ENV/

# Jupyter Notebooks
.ipynb_checkpoints

# PyCharm
.idea/

# VSCode
.vscode/
*.code-workspace

# Training data
episodes/
checkpoints/
/viz/
/test_models/

# Logs and recordings
logs/
*.log

# Temporary files
*.tmp
*.bak
*.swp
*~

# Claude Code
.claude/

# OS files
.DS_Store
Thumbs.db
Desktop.ini
*.stackdump

# Hardware-specific configs (user should copy from templates)
config/local_hardware.yaml

# Build artifacts
*.o
*.a
*.dylib
*.dll
*.exe

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Documentation builds
docs/_build/
docs/_static/
docs/_templates/

# ROS (if used in future)
devel/
build/
install/

# Rerun viewer cache
.rerun/

# SSH keys and credentials
*.pem
*.key
secrets/
scripts/.jetson_password
.env

# Local onshape-to-robot retrieval snapshot (trusted local pickle, not source).
/urdf/minerva/onshape-to-robot/robot.pkl

# URDF meshes (large STL/GLTF) are tracked via Git LFS — see .gitattributes.
# .part files are tiny OnShape provenance metadata, tracked as normal git.
# Decimated display-mesh cache generated on demand by ik.mesh_world (per face budget).
.display_meshes_*.npz

# PlatformIO
.pio/
.pioenvs/
.piolibdeps/
firmware/**/.pio/
