<!-- Viewing scene for the generated Minerva MJCF: lights, sky and a floor at the
     base (z = 0). Presentation only; the floor has no contacts and adds no physics. -->
<mujoco model="minerva scene">
  <include file="minerva.xml"/>
  <statistic center="0 0 .6" extent="1.3"/>
  <visual>
    <headlight diffuse=".6 .6 .6" ambient=".3 .3 .3" specular="0 0 0"/>
    <global azimuth="90" elevation="-15" offwidth="1280" offheight="960"/>
  </visual>
  <asset>
    <texture type="skybox" builtin="gradient" rgb1=".3 .5 .7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="floor" builtin="checker" mark="edge" rgb1=".2 .3 .4" rgb2=".1 .2 .3"
             markrgb=".8 .8 .8" width="300" height="300"/>
    <material name="floor" texture="floor" texuniform="true" texrepeat="5 5" reflectance=".2"/>
  </asset>
  <worldbody>
    <light pos="0 -1.5 3" dir="0 .5 -1" directional="true"/>
    <geom name="floor" type="plane" size="0 0 .05" material="floor" contype="0" conaffinity="0"/>
  </worldbody>
</mujoco>
