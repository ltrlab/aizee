<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="aizee_model">
    <xacro:arg name="ros2_control_hardware_type" default="feetech"/> 
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import aizee_model urdf file -->
    <xacro:include filename="$(find aizee_model)/urdf/aizee_model.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="aizee_model.ros2_control.xacro" />


    <xacro:aizee_model_ros2_control
          name="aizee_hw"
          hardware_type="$(arg ros2_control_hardware_type)"
          initial_positions_file="$(arg initial_positions_file)"/>

</robot>
