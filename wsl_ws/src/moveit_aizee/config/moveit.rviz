Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Views
  Name: Views

Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: base_link          # ← change to your root link if different
    Background Color: 48; 48; 48
  Displays:

  - Class: rviz_default_plugins/Grid
    Name: Grid
    Cell Size: 1
    Plane: XY
    Normal Cell Count: 0
    Plane Cell Count: 10
    Color: 160; 160; 164
    Alpha: 0.5

  - Class: rviz_default_plugins/TF
    Name: TF
    Enabled: true

  - Class: rviz_default_plugins/RobotModel
    Name: RobotModel
    Robot Description: robot_description    # ← change if you used a different param
    Alpha: 0.8

  - Class: moveit_rviz_plugin/MotionPlanning
    Name: MotionPlanning
    Robot Description: robot_description
    Planning Scene Topic: /monitored_planning_scene
    Trajectory Topic: /move_group/display_planned_path
    # (No Move Group is required here; the panel GUI lets you pick)

  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select

  Views:
    Current:
      Class: rviz_default_plugins/Orbit      # ← ROS 2-qualified name
      Name: 3D View
      Distance: 2.0
      Pitch: 0.5
      Yaw: -0.6
      Focal Point:
        X: 0
        Y: 0
        Z: 0

Window Geometry:
  Height: 900
  Width: 1400
  X: 200
  Y: 100

