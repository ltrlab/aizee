[Unit]
Description=AIZEE Camera Relay - bridges Pi PoE streams to WiFi
After=network-online.target aizee-motor-control-rover.service
Wants=network-online.target

[Service]
Type=simple
User=ltr
WorkingDirectory=/home/ltr/aizee
Environment="PYTHONUNBUFFERED=1"
ExecStart=/usr/bin/python3 /home/ltr/aizee/python/camera_relay.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
