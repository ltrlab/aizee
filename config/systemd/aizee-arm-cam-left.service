[Unit]
Description=AIZEE Arm Camera Left (RealSense D435)
# Start when the left arm camera USB device appears; stop on unplug.
BindsTo=dev-realsense_arm_left.device
After=dev-realsense_arm_left.device

[Service]
Type=simple
User=ltr
WorkingDirectory=/home/ltr/aizee
Environment="PYTHONUNBUFFERED=1"
ExecStart=/usr/bin/python3 /home/ltr/aizee/python/nodes/arm_camera_node.py \
    --config /home/ltr/aizee/config/hardware_jetson_arm_cam_left.yaml
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
# Creates /etc/systemd/system/dev-realsense_arm_left.device.wants/ symlink.
# Service starts automatically whenever the camera is plugged in.
WantedBy=dev-realsense_arm_left.device
