[Unit]
Description=AIZEE Gripper Camera (ELP-USBFHD01M-L21, single UVC color)
# Start when the ELP gripper camera USB device appears; stop on unplug.
# The matching udev rule (config/udev/99-aizee-gripper-cam.rules) tags
# the device with SYSTEMD_ALIAS=/dev/aizee_gripper_cam so this unit can
# bind to the synthetic device unit.
BindsTo=dev-aizee_gripper_cam.device
After=dev-aizee_gripper_cam.device

[Service]
Type=simple
User=ltr
WorkingDirectory=/home/ltr/aizee
Environment="PYTHONUNBUFFERED=1"
# Lower priority — camera frames can slip; motor control cannot.
Nice=5
ExecStart=/usr/bin/python3 /home/ltr/aizee/python/nodes/gripper_camera_node.py \
    --config /home/ltr/aizee/config/hardware_jetson_gripper_cam.yaml
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
# Creates /etc/systemd/system/dev-aizee_gripper_cam.device.wants/ symlink.
# Service starts automatically whenever the camera is plugged in.
WantedBy=dev-aizee_gripper_cam.device
