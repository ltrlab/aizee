      "sign": 1
    },
    "left_arm_j6": {
      "leader": "left",
      "channel": 6,
      "sign": 1
    },
    "left_gripper": {
      "leader": "left",
      "channel": 7,
      "sign": 1
    },
    "right_arm_j1": {
      "leader": "right",
      "channel": 1,
      "sign": -1
    },
    "right_arm_j2": {
      "leader": "right",
      "channel": 2,
      "sign": -1
    },
    "right_arm_j3": {
      "leader": "right",
      "channel": 3,
