    "right_arm_j5": {
      "leader": "right",
      "channel": 5,
      "sign": 1
    },
    "right_arm_j6": {
      "leader": "right",
      "channel": 6,
      "sign": 1
    },
    "right_gripper": {
      "leader": "right",
      "channel": 7,
      "sign": 1
    }
  },
  "manual_tuning": true
}
