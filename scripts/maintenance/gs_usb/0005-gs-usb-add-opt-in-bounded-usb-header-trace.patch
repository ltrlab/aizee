+
+static void gs_usb_diag_frame(struct gs_can *dev, const char *event, bool rx,
+			      const struct gs_host_frame *hf, unsigned int length,
+			      int status)
+{
+	if (!diag_frames || atomic_dec_if_positive(&dev->diag_remaining) < 0)
+		return;
+
+	/* The caller has validated the RX header; TX storage is a full frame.
+	 * Do not read payload bytes or uninitialized baseline TX flags here.
+	 */
+	netdev_info(dev->netdev,
+		    "gs_usb trace: %s status=%d length=%u echo=%u can_id=%08x channel=%u dlc=%u rx_flags=%02x active=%d remaining=%d\n",
+		    event, status, length, hf->echo_id,
+		    le32_to_cpu(hf->can_id), hf->channel, hf->can_dlc,
+		    rx ? hf->flags : 0, atomic_read(&dev->active_tx_urbs),
+		    atomic_read(&dev->diag_remaining));
+}
 
